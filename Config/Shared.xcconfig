// Build settings that differ per person or per car.
// These are the defaults; put your own values in Config/Local.xcconfig
// (git-ignored, see Local.xcconfig.example). Run `xcodegen` afterwards.

// Bundle identifier of the app.
APP_BUNDLE_ID = com.example.emuslink

// Apple Developer Team ID for signing (needed to run on an iPhone).
DEVELOPMENT_TEAM =

// Name (or part of it) used to search for the EMUS module.
// Empty = search by the EMUS service only. Can be changed in the app.
DEFAULT_MODULE_NAME =

// Optional: ABRP credentials that are pre-filled on a fresh install.
// They end up in the app bundle; they can be overridden in the app.
ABRP_API_KEY =
ABRP_USER_TOKEN =

#include? "Local.xcconfig"
