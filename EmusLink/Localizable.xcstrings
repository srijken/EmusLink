        }
      }
    },
    "Not enough kilometres driven yet. Turn on GPS in Settings and start driving." : {
      "localizations" : {
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nog niet genoeg kilometers gereden. Zet GPS aan in Instellingen en ga rijden."
          }
        }
      }
    },
    "Nothing measured yet. One value per day is kept; the charts fill up as you drive." : {
      "localizations" : {
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nog niets gemeten. Per dag wordt één waarde bewaard; de grafieken vullen zich terwijl je rijdt."
