        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Temperatuurwaarschuwing"
          }
        }
      }
    },
    "The 10 km and 100 km averages and the chart will start over." : {
      "localizations" : {
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De gemiddelden over 10 en 100 km en de grafiek beginnen dan opnieuw."
          }
        }
      }
    },
    "The 30 days before" : {
      "localizations" : {
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De 30 dagen daarvoor"
          }
        }
      }
    },
    "The learned data and the settings are copied to your iCloud every few minutes and restored after a reinstall or on a new iPhone. After a fresh install the app waits up to 10 minutes for the backup before it writes a new one." : {
      "localizations" : {
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De geleerde gegevens en de instellingen worden om de paar minuten naar je iCloud gekopieerd en teruggezet na een herinstallatie of op een nieuwe iPhone. Na een verse installatie wacht de app tot 10 minuten op de back-up voordat hij een nieuwe schrijft."
          }
        }
      }
    },
    "The spread is growing" : {
      "localizations" : {
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De spreiding groeit"
          }
        }
      }
    },
    "Tomorrow (%@): about %lld km" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Tomorrow (%1$@): about %2$lld km"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Morgen (%1$@): ongeveer %2$lld km"
          }
