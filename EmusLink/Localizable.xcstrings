    "Not enough driving measured yet. The curve appears after a few kilometres at different speeds." : {
      "localizations" : {
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nog niet genoeg gereden. De lijn verschijnt na een paar kilometer op verschillende snelheden."
