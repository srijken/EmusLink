    "Learned" : {
      "localizations" : {
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geleerd"
          }
        }
      }
    },
    "Learned counts from 3 measurements per day; until then the set distance applies. It is a cautious usual day: the distance that covers about three out of four of the last days. The app cannot control charging; this is advice only." : {
      "localizations" : {
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geleerd telt vanaf 3 metingen per dag; tot die tijd geldt de ingestelde afstand. Het is een voorzichtige gewone dag: de afstand die ongeveer drie van de vier laatste dagen dekt. De app kan het laden niet aansturen; dit is alleen een advies."
          }
        }
      }
    },
    "Live Activity" : {
      "localizations" : {
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Live Activity"
          }
        }
